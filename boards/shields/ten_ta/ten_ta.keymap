#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";

            bindings = <
                &kp KP_NUMLOCK  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp DEL
                &kp KP_N7      &kp KP_N8      &kp KP_N9        &kp KP_PLUS   &kp HOME
                &kp KP_N4      &kp KP_N5      &kp KP_N6        &kp KP_ENTER  &kp PG_UP
                &kp KP_N1      &kp KP_N2      &kp KP_N3                      &kp PG_DN
                &kp KP_N0      &kp KP_DOT                                    &kp END
            >;
        };
    };
};